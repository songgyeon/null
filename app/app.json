{
  "expo": {
    "name": "NULL",
    "slug": "null-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#c3b2f0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.songgyeon.nullapp"
    },
    "android": {
      "package": "com.songgyeon.nullapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png",
        "backgroundColor": "#c3b2f0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-audio"
    ]
  }
}
